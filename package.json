{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "build:cloudflare": "node scripts/cloudflare.mjs build",
    "deploy:cloudflare": "node scripts/cloudflare.mjs deploy",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:logic": "node scripts/check-v2.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "node tests/check-api.mjs",
    "test:cloudflare": "node tests/check-cloudflare.mjs",
    "test:restore": "node tests/check-restore-transaction.mjs && node tests/check-migration-upgrade.mjs",
    "test:exports": "node tests/check-export.mjs && node tests/check-report-profiles.mjs",
    "test:advanced": "node tests/check-advanced-modules.mjs && node tests/check-asset-catalog.mjs && node tests/check-script-crypto.mjs && node tests/check-private-scripts.mjs && node tests/check-script-editor.mjs && node tests/check-share-return.mjs && node tests/check-terminal-card.mjs && node tests/check-public-shares.mjs && node tests/check-terminal-qr.mjs && node tests/check-release-safety.mjs",
    "test:security": "node tests/check-secret-scanner.mjs && node tests/check-validation-csp.mjs && node tests/check-quote-sync.mjs && node tests/check-request-body.mjs && node tests/check-quote-provenance.mjs && node tests/check-csp.mjs && node tests/check-security-boundaries.mjs && node tests/check-account-erasure.mjs && node tests/check-storage-cleanup.mjs && node tests/check-user-abuse.mjs && node tests/check-access-matrix.mjs && node tests/check-admin-search.mjs",
    "test:recovery": "node tests/check-operational-recovery.mjs",
    "test:app-security": "node tests/check-app-security.mjs",
    "test:app-browser": "node tests/check-app-browser.mjs",
    "test:queries": "node tests/check-server-query.mjs && node tests/check-sections.mjs",
    "release:inspect": "node scripts/release-tools.mjs inspect",
    "release:dry-run": "node scripts/cloudflare.mjs dry-run",
    "test:release": "node tests/check-release-safety.mjs",
    "build:visual-demo": "node scripts/build-visual-demo.mjs",
    "test:visual-contracts": "node tests/check-visual-contracts.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@hookform/resolvers": "^5.7.1",
    "@lezer/highlight": "1.2.5",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@cloudflare/workers-types": "5.20261117.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "json-rpc-2.0": "1.7.1",
    "jsqr": "1.4.0",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "type": "module",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
